# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Meta Graph API ──────────────────────────────────────────────────────────
# Platform-level fallback token. Tenants normally store their own token in the
# vault (Settings → API credentials), encrypted at rest.
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-webhook-verify-token
META_SYSTEM_USER_TOKEN=

# ── Demo mode ───────────────────────────────────────────────────────────────
# When Supabase vars are absent the app boots in demo mode with seeded data
# held in memory. Credentials below are the demo logins.
DEMO_MODE=auto
